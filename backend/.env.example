PROJECT_NAME="AegisSOC Alert Enrichment System"
VERSION="1.0.0"

# Database Configuration (PostgreSQL default, falls back to SQLite if PostgreSQL is not active)
DATABASE_URL=postgresql://soc_admin:soc_secure_pass@localhost:5432/soc_alerts

# Redis Cache (Falls back to in-memory cache if Redis is not active)
REDIS_URL=redis://localhost:6379/0

# Threat Intelligence APIs (Optional: Leaving blank activates high-fidelity realistic simulations)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
